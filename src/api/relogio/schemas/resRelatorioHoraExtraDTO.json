      "type": "object",
      "properties": {
        "totalTransportes": {
          "type": "object",
          "example": { "UBER": 5, "TAXI": 2, "FRETADO": 1, "N/A": 10 }
        },
        "totalRefeicoes": {
          "type": "object",
          "example": { "MARMITEX": 10, "LANCHE": 15, "N/A": 3 }
        }
      },
      "required": ["totalTransportes", "totalRefeicoes"],
      "x-readme-ref-name": "RelatorioRecursosResumoDTO"
    },
    "detalhamentoPorSetor": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "setor": { "type": "string", "example": "LASER" },
          "justificativa": {
            "type": "string",
            "example": "Finalizacao de lote urgente"
          },
          "dataContexto": { "format": "date-time", "type": "string" },
          "totalPessoas": { "type": "number", "example": 5 },
          "funcionarios": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "matricula": { "type": "string", "example": "001" },
                "nome": { "type": "string", "example": "Funcionario Um" },
                "transporte": {
                  "type": "string",
                  "enum": ["UBER", "TAXI", "FRETADO", "N/A"],
                  "example": "UBER"
                },
                "inicioHE": { "type": "string", "example": "17:00" },
                "fimHE": { "type": "string", "example": "19:30" },
                "refeicao": {
                  "type": "string",
                  "enum": ["MARMITEX", "LANCHE", "N/A"],
                  "example": "MARMITEX"
                },
                "justificativa": {
                  "type": "string",
                  "example": "Finalizacao de lote urgente"
                },
                "categoria": {
                  "nullable": true,
                  "description": "Categoria da hora extra do funcionario. Null em folhas legadas.",
                  "type": "object",
                  "allOf": [
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "description": "ID MongoDB da categoria.",
                          "example": "6651f3f0f0f0f0f0f0f0f0f0"
                        },
                        "codigo": {
                          "type": "string",
                          "description": "Código único da categoria.",
                          "example": "DEMANDA_URGENTE"
                        },
                        "nome": {
                          "type": "string",
                          "description": "Nome exibido da categoria.",
                          "example": "Demanda urgente"
                        }
                      },
                      "required": ["id", "codigo", "nome"],
                      "x-readme-ref-name": "ResCategoriaHoraExtraResumoDTO"
                    }
                  ]
                }
              },
              "required": [
                "matricula",
                "nome",
                "transporte",
                "inicioHE",
                "fimHE",
                "refeicao",
                "justificativa"
              ],
              "x-readme-ref-name": "ResItemFuncionarioHEDTO"
            }
          },
          "totaisPorCategoria": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "codigo": {
                  "type": "string",
                  "nullable": true,
                  "description": "Codigo da categoria. Null para itens de folhas legadas (Sem categoria).",
                  "example": "DEMANDA_URGENTE"
